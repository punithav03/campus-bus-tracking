node_modules/
.next/
out/
*.tsbuildinfo
next-env.d.ts
# Runtime only. The route itself (data/routes, data/network.json) IS committed
# — without it the deployed app has no bus route at all.
data/trips/*.jsonl
data/recordings/*.json
# Secrets. This repo is public: an .env.local holding driver PINs would be
# committed and readable by anyone who finds it. The PIN belongs in the host's
# environment, and locally in a file that can never be pushed.
.env
.env.*
!.env.example

.DS_Store

.cert/

# Android build output. The android/ project itself IS committed — it is part
# of the app — but these are generated, machine-specific, or huge.
android/build/
android/app/build/
android/.gradle/
android/.idea/
android/captures/
android/local.properties
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
