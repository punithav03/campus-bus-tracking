# Copy to .env.local and fill in. .env.local is gitignored and must stay that way.

# Neon Postgres. Use the POOLED connection string — its host contains "-pooler".
# Without the pooler a few hundred students signing in at 7am exhausts the
# server's connection limit.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Signs the login cookie. Any long random string; changing it signs everyone out.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Web Push. Generate a pair once and keep them:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:transport@svpcet.ac.in

# The transport office account's password, used by the seed and reset scripts.
# Set a real one before this is reachable from the internet.
ADMIN_PASSWORD=
