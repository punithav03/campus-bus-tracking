{
  "name": "campus-bus-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "Real-time college bus tracker — route-projected positions, learned ETAs, offline-capable. Runs entirely on this laptop.",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start",
    "seed": "node scripts/seed.mjs",
    "lint": "next lint",
    "discover": "node scripts/discover.mjs",
    "host": "next build && node server.mjs",
    "host:fast": "node server.mjs",
    "cert": "node scripts/make-cert.mjs",
    "import-trace": "node scripts/import-trace.mjs",
    "villages": "node scripts/find-villages.mjs",
    "diagnose": "node scripts/diagnose-ingest.mjs",
    "seed:reroute": "node scripts/seed.mjs --refresh-shape",
    "roads": "node scripts/check-roads.mjs",
    "icons": "node scripts/make-icons.mjs",
    "demo:reset": "node scripts/demo-reset.mjs",
    "test": "node scripts/_auth.test.mjs && node scripts/_premium.test.mjs && node scripts/_demo.test.mjs"
  },
  "dependencies": {
    "@capacitor-community/background-geolocation": "^1.2.26",
    "@capacitor/android": "^7.6.8",
    "@capacitor/core": "^7.6.8",
    "@capacitor/status-bar": "^7.0.6",
    "bcryptjs": "^3.0.3",
    "maplibre-gl": "^4.7.1",
    "next": "^16.3.1",
    "pg": "^8.23.1",
    "qrcode-terminal": "^0.12.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.6.8",
    "@types/node": "^20.16.11",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/web-push": "^3.6.4",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
